# Copy this file to ".env" and fill in your key. The app loads .env automatically.
# The in-agent hook uses STRAIKER_AGENT_API_KEY if set, otherwise STRAIKER_API_KEY.
STRAIKER_AGENT_API_KEY=sk_agt_REPLACE_ME

# detect = report to Straiker, allow through (demo default)
# block  = raise and stop the turn when Straiker blocks
# off    = no inspection at all
STRAIKER_MODE=detect

# Ollama model (must be pulled: `ollama pull qwen2.5:7b`)
OLLAMA_MODEL=qwen2.5:7b

# Optional: only needed for the Gateway (②) vantage, which routes model calls
# through a LiteLLM proxy. Leave as-is if you only use the In-agent (①) vantage.
# GATEWAY_URL=http://127.0.0.1:4000
# GATEWAY_KEY=sk-lab-master
# GATEWAY_MODEL=lab-model
